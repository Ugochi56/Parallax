# Parallax / NEXUS Quant Engine — Environment Configuration Example
# Copy to .env and populate with your own credentials (never commit .env).

# MetaTrader 5 Terminal Settings
MASTER_LOGIN=
MASTER_MT5_PATH=
MT5_DEFAULT_PATH=
MT5_TERMINAL_1_PATH=
MT5_TERMINAL_2_PATH=

# Optional Telemetry / Licensing Backend (Supabase)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Optional Telegram Alerts & Channel Broadcast
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_PUBLIC_CHANNEL_ID=
TELEGRAM_PRIVATE_CHANNEL_ID=
PAYMENT_LINK=https://t.me/NexusQuantBot
